.venv/
.quarto/

# PDFs are never published, with one exception: MAPDA is the only course
# where notes can be brought to the exam, so it is the only book shipped as
# a PDF. Every other course is HTML-only.
*.pdf
!docs/1sem/MAPDA/*.pdf

# Figures that the HTML pages embed directly (knitr's figure-html output)
# are page assets, not downloadable notes, so they stay tracked.
!docs/**/figure-html/*.pdf
